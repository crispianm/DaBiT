{
    "seed": 2023,
    "save_dir": "experiments_model/",
    "train_data_loader": {
        "name": "youtube-vos",
        "video_root": "T:/ProPainter Datasets/youtube-vos/JPEGImages",
        "flow_root": "T:/ProPainter Datasets/youtube-vos/flows/JPEGImages",
        "depth_root": "T:/ProPainter Datasets/youtube-vos/depths/JPEGImages",
        "w": 432,
        "h": 240,
        "num_local_frames": 10,
        "num_ref_frames": 1,
        "load_flow": 1,
        "load_depth": 1
    },
    "losses": {
        "depth_weight": 0.25
    },
    "model": {
        "net": "recurrent_depth_completion"
    },
    "trainer": {
        "version": "trainer_depth",
        "type": "Adam",
        "beta1": 0,
        "beta2": 0.99,
        "lr": 5e-5,
        "batch_size": 8,
        "num_workers": 0,
        "num_prefetch_queue": 4,
        "log_freq": 10,
        "save_freq": 5000,
        "iterations": 500000,
        "scheduler": {
            "type": "MultiStepLR",
            "milestones": [
                300e3,
                400e3,
                500e3,
                600e3
            ],
            "gamma": 0.2
        }
    }
}


