{
    "seed": 2023,
    "out_dir": "/mnt/DATA/dabit/output",
    "dl_config": {
        "w_train": 864,
        "h_train": 480,
        "num_local_frames": 10,
        "num_ref_frames": 6,
        "load_flow": 1,
        "use_blur_masks": 1
    },
    "youtube-vos": {
        "name": "youtube-vos",
        "video_root": "/mnt/DATA/dabit_training_data/youtube-vos"
    },
    "bvidvc": {
        "name": "bvidvc",
        "video_root": "/mnt/DATA/dabit_training_data/bvidvc"
    },
    "losses": {
        "blur_weight": 1,
        "clear_weight": 1,
        "flow_weight": 1,
        "depth_weight": 1,
        "adversarial_weight": 0.01,
        "GAN_LOSS": "hinge",
        "perceptual_weight": 0,
        "kd_weight": 0,
        "sr_weight": 1
    },
    "net": "dabit",
    "interp_mode": "nearest",
    "trainer": {
        "version": "trainer",
        "type": "AdamW",
        "lr": 1e-4,
        "batch_size": 1,
        "num_workers": 0,
        "num_prefetch_queue": 16,
        "img_freq": 500,
        "log_freq": 50,
        "save_freq": 10000,
        "iterations": 750e3,
        "scheduler": {
            "type": "CosineAnnealingLR"
        }
    }
}