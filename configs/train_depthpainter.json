{
    "seed": 2023,
    "save_dir": "experiments_model/",
    "train_data_loader": {
        "name": "youtube-vos",
        "video_root": "T:/ProPainter Datasets/youtube-vos/JPEGImages",
        "flow_root": "T:/ProPainter Datasets/youtube-vos/flows/JPEGImages",
        "depth_root": "T:/ProPainter Datasets/youtube-vos/depths/JPEGImages",
        "w": 432,
        "h": 240,
        "num_local_frames": 10,
        "num_ref_frames": 6,
        "load_flow": 1,
        "load_depth": 1
    },
    "losses": {
        "hole_weight": 1,
        "valid_weight": 1,
        "flow_weight": 1,
        "adversarial_weight": 0.01,
        "GAN_LOSS": "hinge",
        "perceptual_weight": 0
    },
    "model": {
        "net": "propainter",
        "no_dis": 1,
        "load_d": 1,
        "interp_mode": "nearest"
    },
    "trainer": {
        "version": "trainer",
        "type": "Adam",
        "beta1": 0,
        "beta2": 0.99,
        "lr": 1e-4,
        "batch_size": 2,
        "num_workers": 0,
        "num_prefetch_queue": 8,
        "log_freq": 50,
        "save_freq": 500,
        "iterations": 500e3,
        "scheduler": {
            "type": "MultiStepLR",
            "milestones": [
                400e3
            ],
            "gamma": 0.1
        }
    }
}