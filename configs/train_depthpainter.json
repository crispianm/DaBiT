        "depth_root": "T:/ProPainter Datasets/youtube-vos/depths"
    },
    "bvidvc": {
        "name": "bvidvc",
        "video_root": "T:/ProPainter Datasets/bvidvc/frames",
        "flow_root": "T:/ProPainter Datasets/bvidvc/flows",
        "depth_root": "T:/ProPainter Datasets/bvidvc/depths"
    },
    "low_light_10": {
        "name": "low_light_10",
        "video_root": "T:/ProPainter Datasets/low_light_10/frames",
        "flow_root": "T:/ProPainter Datasets/low_light_10/flows",
        "depth_root": "T:/ProPainter Datasets/low_light_10/depths"
